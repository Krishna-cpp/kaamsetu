{
  "name": "kaamsetu",
  "version": "0.1.0",
  "private": true,
  "description": "Voice-first, multilingual, hyper-local job matching for India's informal workers.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*",
    "infra"
  ],
  "scripts": {
    "dev": "npm run dev -w @kaamsetu/web",
    "build": "npm run build -w @kaamsetu/web",
    "start": "npm run start -w @kaamsetu/web",
    "bot": "npm run dev -w @kaamsetu/bot",
    "seed": "tsx scripts/seed.ts",
    "pregen:audio": "tsx scripts/pregen-audio.ts",
    "agent:create": "tsx scripts/create-elevenlabs-agent.ts",
    "agent:test": "tsx scripts/test-agent.ts",
    "voices": "tsx scripts/list-voices.ts",
    "voices:design": "tsx scripts/design-voices.ts",
    "test": "vitest run",
    "typecheck": "tsc -p packages/core --noEmit && tsc -p services/bot --noEmit && npm run typecheck -w @kaamsetu/web",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "cross-env": "^10.1.0",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "rimraf": "^6.1.4",
    "tsx": "^4.23.15",
    "typescript": "5.7",
    "vitest": "^3.2.7"
  }
}
