# ─────────────────────────────────────────────────────────────────────────────
# KaamSetu configuration. Copy to `.env` (repo root) and fill in.
# Everything is optional: with no keys the whole app runs on realistic mocks.
# ─────────────────────────────────────────────────────────────────────────────

# Force every integration onto mocks (zero external calls). Great for rehearsing the pitch offline.
DEMO_MODE=false
# Public URL of the web app (used in links sent by the bot / agent)
PUBLIC_BASE_URL=http://localhost:3000
# Speed multiplier for simulated seed-worker replies in the demo (2 = twice as fast)
SIM_SPEED=1

# ── AWS ──────────────────────────────────────────────────────────────────────
AWS_PROFILE=meteora
AWS_REGION=ap-south-1

# LLM: `mock` = rule-based Hindi/Marathi/English parser, `bedrock` = Amazon Bedrock Converse API
LLM_PROVIDER=mock
BEDROCK_REGION=ap-south-1
# Amazon Nova Pro via the APAC inference profile. Switch to Claude by changing only this line,
# e.g. apac.anthropic.claude-3-5-sonnet-20241022-v2:0 (use the id `aws bedrock list-inference-profiles` shows)
BEDROCK_MODEL_ID=apac.amazon.nova-pro-v1:0

# Data store: `file` (data/db.json, local) or `dynamo` (DynamoDB single table)
STORE=file
DYNAMO_TABLE=kaamsetu
# Optional custom path for the file store
DATA_FILE=

# Blob storage for audio: `local` (apps/web/public/media) or `s3`
STORAGE=local
S3_BUCKET=
S3_PUBLIC_BASE_URL=

# Geocoding: `mock` (built-in Pune locality table) or `aws` (Amazon Location Service Places v2)
GEO_PROVIDER=mock
# Amazon Location map style for MapLibre tiles (browser-side API key, restricted to your domain)
NEXT_PUBLIC_AWS_LOCATION_API_KEY=
NEXT_PUBLIC_AWS_LOCATION_REGION=ap-south-1

# ── ElevenLabs ───────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v1
# Quality voice (confirmations, landing demo) and low-latency voice (job alerts)
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_ALERT_MODEL=eleven_flash_v2_5
# Voice ids per language (run `npm run voices` to list yours). Empty = a multilingual default.
ELEVENLABS_VOICE_ID_HI=
ELEVENLABS_VOICE_ID_MR=
ELEVENLABS_VOICE_ID_EN=
# Voice for the worker in the landing demo clip
ELEVENLABS_WORKER_VOICE_ID=
# Conversational AI agent "Kaam Didi" — created by `npm run agent:create`
ELEVENLABS_AGENT_ID=
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=
# Shared secret the agent sends to our tool webhooks (header: x-kaamsetu-secret)
AGENT_TOOL_SECRET=

# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Random string; Telegram echoes it in X-Telegram-Bot-Api-Secret-Token on webhook calls
TELEGRAM_WEBHOOK_SECRET=

# ── Scheme Finder ("My Benefits", opt-in) ──────────────────────────────────────
# Off unless true. NEXT_PUBLIC_ copy controls the landing section and the /chat chip.
FEATURE_SCHEMES=false
NEXT_PUBLIC_FEATURE_SCHEMES=false
# HMAC secret for private work-record links (defaults to AGENT_TOOL_SECRET)
WORK_RECORD_SECRET=
